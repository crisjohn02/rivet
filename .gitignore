# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed for the binary; do not ignore it.

# rivet's own cache when run against this repository
/.rivet/

# Benchmark raw artifacts are large and may contain transcripts; keep results/ and preregistration.
/benchmark/raw/

# Private benchmark corpus copies must never enter this public repository.
# fetch-corpus.sh refuses in-repo destinations; this is a second guard.
/benchmark/corpus/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local scratch
/tmp/

# Python bytecode (benchmark runner)
__pycache__/
